{
  "name": "freelancers-network",
  "version": "1.0.0",
  "description": "The self-sustainable, not-for-profit, open-source network for freelancers",
  "author": "Freelance Founders for Business Systems",
  "license": "AGPL-3.0-only",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/founders-bh/freelancers-network.git"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build",
    "preview": "vike build && vike preview",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "wrangler d1 migrations apply FREELANCERS_NETWORK_DATABASE --local",
    "drizzle:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "deploy": "vike build && wrangler deploy",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@auth/core": "^0.41.1",
    "@photonjs/cloudflare": "^0.1.13",
    "@photonjs/hono": "^0.1.12",
    "@universal-middleware/core": "^0.4.16",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "telefunc": "^0.2.17",
    "vike": "^0.4.252",
    "vike-photon": "^0.1.24",
    "vike-vue": "^0.9.10",
    "vue": "^3.5.27"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20.19.30",
    "@vitejs/plugin-vue": "^6.0.3",
    "daisyui": "^5.5.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vue-eslint-parser": "^10.2.0",
    "wrangler": "^4.61.1"
  }
